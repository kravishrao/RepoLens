# =============================================================================
# RepoLens Environment Configuration Template
# Copy this file to '.env' and adjust variables as needed for your local environment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# System & Path Configuration
# -----------------------------------------------------------------------------
# Directory where cached models, indexes, and evaluations are persisted
REPOLENS_CACHE_DIR=.cache/repolens

# Default logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
REPOLENS_LOG_LEVEL=INFO

# Default repository directory to load on startup (relative or absolute path)
REPOLENS_DEFAULT_REPO=dataset/repositories/requests

# -----------------------------------------------------------------------------
# Retrieval & Embedding Configuration
# -----------------------------------------------------------------------------
# Sentence Transformers embedding model for semantic retrieval
REPOLENS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Maximum number of candidate CodeUnits to retrieve in hybrid search
REPOLENS_RETRIEVAL_TOP_K=10

# Hybrid fusion weight for semantic retrieval vs BM25 lexical retrieval (0.0 to 1.0)
REPOLENS_SEMANTIC_WEIGHT=0.5

# -----------------------------------------------------------------------------
# Investigation Agent Configuration (LangGraph)
# -----------------------------------------------------------------------------
# Maximum iteration loops for the investigation agent
REPOLENS_MAX_ITERATIONS=4

# Maximum number of evidence units retained per investigation
REPOLENS_MAX_EVIDENCE=20

# Minimum evidence threshold required before early termination
REPOLENS_MIN_EVIDENCE=0

# -----------------------------------------------------------------------------
# Streamlit UI Configuration
# -----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# -----------------------------------------------------------------------------
# Optional LLM Provider Configuration (Optional - RepoLens includes local fallback)
# Only required if plugging in custom external LLM providers for synthesis
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
